@startuml
' Діаграма розгортання (друкарська версія): чотири сервіси docker-compose.yml.
' Автор: Андрій Жук, 2026.
skinparam dpi 200
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 15
skinparam node {
  BackgroundColor #F7F9FC
  BorderColor #33507A
}
top to bottom direction
node "Браузер оператора" as BR
node "Хост розробника (Docker Compose)" {
  node "ui\nnode:22-alpine\nVite :5173" as UI
  node "api\nuvicorn :8000" as API
  node "worker\ntrading_worker" as WK
  database "db\npostgres:16-alpine\n:5442" as DB
}
cloud "Binance testnet /\nпублічні read-only" as EX
BR --> UI : HTTP
UI --> API : /api (проксі)
API --> DB : SQL, LISTEN
WK --> DB : SQL, NOTIFY
WK --> EX : REST / WS
@enduml
