@startuml seq_ws_gap_backfill
' Sequence «розрив WS → прогалина → REST-добір» за кодом src/fuzzhelm/ingest/{ws_client,reconnect,pipeline,
' gap_detector,candles,backfill,rest_client}.py (HEAD b933802). Автор: Андрій Жук, 2026.
title Розрив WS → прогалина → REST-добір (IngestPipeline)
skinparam defaultFontName Helvetica
skinparam shadowing false
autonumber

participant "fstream.binance.com\n/market/stream" as MKT
participant "fstream.binance.com\n/public/stream" as PUB
participant "BinanceWsClient\n(Backoff, HeartbeatWatchdog)" as WS
participant "IngestPipeline" as PIPE
participant "Deduplicator" as DEDUP
participant "GapDetector" as GAP
participant "CandleAggregator" as AGG
participant "RestBackfiller" as RB
participant "BinanceRestClient\n(TokenBucket, RetryPolicy)" as REST
participant "fapi.binance.com" as FAPI
participant "стоки PipelineSinks\n(on_gap → ingest_gap,\non_candle → candle,\non_event → event_journal)" as SINK

== Розрив з'єднання market (kline, aggTrade, markPrice) ==
MKT -x WS : close-кадр / тиша ≥ heartbeat_timeout_s (10 с)
WS -> WS : classify_exception → Disconnect(conn=market, CloseClass)
WS -> PIPE : process(ControlRecord «disconnected»)
PIPE -> PIPE : _on_control → _disconnect(d)\nhealth.on_disconnect
PIPE -> GAP : flush()  (лише для market: угоди йдуть ним)
GAP --> PIPE : підтверджені дірки aggTrade id → GapRecord(OPEN, detector=seq)
WS -> WS : sleep(backoff.next_delay()) — equal jitter, cap 30 с\n(перше NORMAL-закриття — повтор без паузи)
WS -> MKT : перепідключення
WS -> PIPE : process(ControlRecord «connected»)\n(у реплеї — watchdog.beat конвеєра; у live сторож тиші живе в самому BinanceWsClient)

== Тим часом public (depth) рухає біржовий час ==
PUB -> WS : кадр depth20@100ms
WS -> PIPE : process(RawFrame)
PIPE -> PIPE : normalize_binance → check_book (інваріанти)
PIPE -> DEDUP : offer(ev)
DEDUP --> PIPE : NEW
PIPE -> SINK : on_event(ev) (журнал подій)
PIPE -> GAP : on_time(ts_event_ns)
note right of GAP
  хвилина m втрачена, якщо біржовий час
  ≥ m + tf + grace_ms (2 000 мс) і закритої
  свічки m немає → GapRecord(OPEN, detector=time),
  exchange_ns = максимум ts_event на момент виявлення
end note
GAP --> PIPE : [GapRecord OPEN]

== Добір (_on_gaps → _fill_loop) ==
PIPE -> SINK : on_gap(OPEN)
PIPE -> GAP : begin_fill(gap_id)
GAP --> PIPE : GapRecord(FILLING, attempts + 1)
PIPE -> SINK : on_gap(FILLING)
PIPE -> RB : backfill(gap)
alt stream = KLINES
  RB -> REST : backfill_klines(symbol, lo_ms, hi_ms,\nnow_ms = gap.exchange_ns // 10⁶)
  REST -> REST : bucket.acquire(klines_weight(limit))
  REST -> FAPI : GET /fapi/v1/klines?startTime&endTime&limit
  FAPI --> REST : рядки klines + X-MBX-USED-WEIGHT-1M
  REST -> REST : observe_used_weight (лише зменшує токени)
  REST --> RB : BackfillResult(candles, gaps)
else stream = TRADES (seq_lo..seq_hi)
  RB -> REST : agg_trades(symbol, from_id = seq_lo, limit ≤ 1000)
  REST -> FAPI : GET /fapi/v1/aggTrades?fromId (вага 20, виміряна)
  FAPI --> REST : угоди {a,p,q,f,l,T,m}
  REST --> RB : normalize_rest_agg_trade → Trade (той самий event_uid, що у WS)
end
RB --> PIPE : FillResult(events, requests)
loop кожна подія добору
  PIPE -> PIPE : _accept(ev, from_stream=False)\n(інваріанти, лаг не рахується)
  PIPE -> DEDUP : offer(ev) (DUPLICATE → відкинуто)
  PIPE -> SINK : on_event(ev) (журнал); угода — ще й on_trade(t)
  PIPE -> GAP : on_kline(c) / on_trade(t)
  PIPE -> AGG : offer(candle)
  AGG --> PIPE : закриті свічки строго за open_time\n(m+1 утримувалась, доки m не випущено)
  PIPE -> SINK : on_candle(c)
end
PIPE -> GAP : resolve(gap_id)
GAP --> PIPE : FILLED | PARTIAL | UNFILLABLE (поштучний облік)
PIPE -> SINK : on_gap(статус, filled_rows, closed_at)
opt статус ≠ FILLED (KLINES)
  PIPE -> AGG : skip(m, m) для недобраних хвилин
  note right of AGG : рядок ingest_gap у статусі PARTIAL / UNFILLABLE\nпідбирає нічний добір scheduler.retry_gaps (02:30 UTC)
end
@enduml
