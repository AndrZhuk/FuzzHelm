@startuml class_detectors_strategy
' Діаграма класів: детектори (патерн Strategy), рушій виводу, ядро рішень (detectors/*, fuzzy/*, decision/*).
' Імена — фактичні класи src/fuzzhelm/{detectors,decision,fuzzy,risk} (HEAD b933802). Автор: Андрій Жук, 2026.
title Детектори і рушій виводу як стратегії (патерн Strategy) у DecisionCore
skinparam defaultFontName Helvetica
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam nodesep 30
top to bottom direction

package "detectors" {
  enum DetectorGroup {
    TREND
    REVERSION
    CONTEXT
  }
  class DetectorOutput <<frozen dataclass>> {
    + name : str
    + s : float  ∈ [−1; 1]
    + c : float  ∈ [0; 1]
    + features : Mapping[str, float]
    + group : DetectorGroup
    + weight : float  ≥ 0 (DEC-04)
  }
  interface Detector <<Protocol>> {
    + name : str
    + group : DetectorGroup
    + weight : float
    + warmup : int
    + compute(window : BarWindow) : DetectorOutput
  }
  class EmaSlope {
    group = TREND, ω = 1.0, warmup 26
    s = tanh(g/0.15); c = R² OLS
  }
  class Donchian {
    group = TREND, ω = 1.0, warmup 21
    s = tanh(d/0.5); c = ширина·exp(−0.3·вік)
  }
  class RsiExhaustion {
    group = REVERSION, ω = 0.8, warmup 29
    s = sign(z)|z|^1.6; c з div_score
  }
  class BollingerZ {
    group = REVERSION, ω = 0.8, warmup 219
    s = −tanh(z/2); c = 1 − ρ
  }
  class CandleGeometry {
    group = REVERSION, ω = 0.6, warmup 21
    пін-бари + поглинання
  }
  class VolRegime {
    group = CONTEXT, ω = 1.0, warmup 523
    s = 0; features["V"] = V_t
  }
  class "registry" as REG <<module>> {
    + DETECTOR_NAMES : tuple[str, ...]
    + build_detectors(cfg) : list[Detector]
  }
}

package "fuzzy" {
  interface InferenceEngine <<Protocol>> {
    + name : str
    + infer(T, R, V) : FuzzyResult
  }
  class MamdaniEngine {
    + infer(T, R, V) : FuzzyResult
    + infer_u(T, R, V) : float
    + infer_batch(T, R, V) : ndarray
  }
  class LinearVoteEngine {
    u = clip((w_T·T + w_R·R)/(|w_T| + |w_R|))
  }
  class FuzzyResult {
    u_raw, memberships, fired : FiredRule[], grid, mu_agg
  }
}

package "decision" {
  class DecisionCore {
    + detectors : tuple[Detector, ...]
    + engine : InferenceEngine
    + kappa_min = 0.35 ; nu = 1.0
    + decide(window) : DecisionTrace
    + intent(window) : (u_raw, κ, u_final)
  }
  class Consensus {
    T, R, V, v_source
  }
  class Agreement {
    p_plus, p_minus, p_zero, H, A_g, kappa
  }
  class DecisionTrace <<frozen>> {
    u_raw, kappa, u_final, fired_rules
    sizing, risk
    + with_sizing() / with_risk()
  }
}

Detector ..> DetectorOutput : повертає
DetectorOutput --> DetectorGroup
EmaSlope ..|> Detector
Donchian ..|> Detector
RsiExhaustion ..|> Detector
BollingerZ ..|> Detector
CandleGeometry ..|> Detector
VolRegime ..|> Detector
REG ..> Detector : створює 6
MamdaniEngine ..|> InferenceEngine
LinearVoteEngine ..|> InferenceEngine
InferenceEngine ..> FuzzyResult
DecisionCore o-- "6" Detector : стратегії свідчень
DecisionCore o-- "1" InferenceEngine : стратегія виводу
DecisionCore ..> Consensus : consensus()
DecisionCore ..> Agreement : agreement()
DecisionCore ..> DecisionTrace

note bottom of DecisionCore
  Патерн Strategy двічі: детектори (Detector) і рушій виводу
  (InferenceEngine: mamdani | linear) замінні без зміни ядра.
  u_final = clip(κ·u_raw, −1, 1); |u_final| ≤ |u_raw|.
end note
@enduml
